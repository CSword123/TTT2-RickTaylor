 #define VFS_ROOT VfsRoot()
 
+// Mod files laid over the game's: a file at <TTT2_MOD_ROOT>/<path> is served instead of
+// <VFS_ROOT>/<path> (update: paths look in <TTT2_MOD_ROOT>/update). Unset or empty = no overlay.
+// The installed layout defaults it to the mods folder next to the exe (main.cpp).
+static const std::string& ModRoot()
+{
+    static const std::string root = [] {
+        const char* e = std::getenv("TTT2_MOD_ROOT");
+        return std::string(e && *e ? e : "");
+    }();
+    return root;
+}
+
+static bool ModFile(const std::string& rel, std::string& out)
+{
+    if (ModRoot().empty()) return false;
+    std::error_code ec;
+    std::string full = ModRoot() + "/" + rel;
+    if (!std::filesystem::is_regular_file(full, ec)) return false;
+    out = std::move(full);
+    return true;
+}
